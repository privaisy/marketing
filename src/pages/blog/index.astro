---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const formatDate = (date: Date) => date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="Blog — Privaisy">
  <div class="bg-white px-4 pb-16 pt-32">
    <div class="mx-auto flex max-w-page flex-col gap-8">
      <div class="flex max-w-[648px] flex-col gap-6">
        <h1 class="text-h1 text-pine">Blog</h1>
        <p class="text-sub text-pine">News and insights for privacy-minded teams.</p>
      </div>
      <div class="flex flex-col gap-6 md:flex-row md:flex-wrap">
        {sorted.map((post) => (
          <article class="flex w-full flex-col overflow-hidden rounded-lg md:w-[calc(50%-12px)] lg:w-[calc(33.333%-16px)]">
            <div class="h-[200px] w-full" style="background: #e5e7e6;"></div>
            <div class="flex flex-col gap-6 bg-lime-50 p-6">
              <div class="flex flex-col gap-4">
                <span class="text-small text-pine/50">{formatDate(post.data.date)}</span>
                <h2 class="text-h5 text-pine">{post.data.title}</h2>
                <p class="font-body text-pine">{post.data.description}</p>
              </div>
              <a href={`/blog/${post.slug}`} class="text-link text-pine underline">
                Read article &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
