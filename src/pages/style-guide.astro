---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Style Guide — Privaisy" description="Privaisy brand style guide including colors and typography.">
  <div class="bg-white px-4 pb-24 pt-32">
    <div class="mx-auto flex max-w-page flex-col gap-16">
      <div class="flex max-w-[720px] flex-col gap-6">
        <h1 class="text-h1 text-pine">Style Guide</h1>
        <p class="text-sub text-pine/70">Brand assets, colors, and typography for Privaisy.</p>
      </div>

      <section class="flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <h2 class="text-h2 text-pine">Colors</h2>
          <hr class="border-pine/10" />
        </div>
        <div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-5">
          <div class="flex flex-col gap-3">
            <div class="h-24 w-full rounded-lg bg-pine"></div>
            <div class="flex flex-col">
              <span class="text-body-medium text-pine">Pine</span>
              <span class="text-small text-pine/50">#113224</span>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="h-24 w-full rounded-lg bg-lime"></div>
            <div class="flex flex-col">
              <span class="text-body-medium text-pine">Lime</span>
              <span class="text-small text-pine/50">#88E54C</span>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="h-24 w-full rounded-lg bg-lime-50"></div>
            <div class="flex flex-col">
              <span class="text-body-medium text-pine">Lime 50</span>
              <span class="text-small text-pine/50">#F3F5F4</span>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="h-24 w-full rounded-lg bg-ink"></div>
            <div class="flex flex-col">
              <span class="text-body-medium text-white">Ink</span>
              <span class="text-small text-white/50">#181B1A</span>
            </div>
          </div>
          <div class="flex flex-col gap-3">
            <div class="h-24 w-full rounded-lg border border-pine/10 bg-white"></div>
            <div class="flex flex-col">
              <span class="text-body-medium text-pine">White</span>
              <span class="text-small text-pine/50">#FFFFFF</span>
            </div>
          </div>
        </div>
      </section>

      <section class="flex flex-col gap-8">
        <div class="flex flex-col gap-2">
          <h2 class="text-h2 text-pine">Typography</h2>
          <hr class="border-pine/10" />
        </div>
        <div class="flex flex-col gap-8">
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Display</span>
            <span class="text-display text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">H1</span>
            <span class="text-h1 text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">H2</span>
            <span class="text-h2 text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">H3</span>
            <span class="text-h3 text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">H4</span>
            <span class="text-h4 text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">H5</span>
            <span class="text-h5 text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">H6</span>
            <span class="text-h6 text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Sub</span>
            <span class="text-sub text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Body</span>
            <span class="text-body text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Body Medium</span>
            <span class="text-body-medium text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Small</span>
            <span class="text-small text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Label</span>
            <span class="text-label text-pine">Aa</span>
          </div>
          <div class="flex items-baseline gap-6">
            <span class="w-24 text-small text-pine/50">Link</span>
            <span class="text-link text-pine">Aa</span>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
