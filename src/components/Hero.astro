---
import Button from './Button.astro';
---
<section
  id="hero"
  class="relative flex min-h-[calc(100vh-5rem)] items-center overflow-hidden bg-lime-50 px-4 py-24"
>
  <div class="mx-auto flex w-full max-w-page flex-col items-center gap-10">
    <div class="flex w-full max-w-[920px] flex-col items-center gap-6">
      <h1 class="max-w-[800px] text-center text-h1 text-pine md:text-display">
        Private AI for <i>Your</i> Business
      </h1>
      <p class="max-w-[500px] text-center text-sub text-pine">
        Stop exposing your sensitive data, trade secrets, or proprietary
        information. Get managed private infrastructure — no per-seat fees, no
        compliance risk, no IT staff required.
      </p>
      <div
        class="flex w-full max-w-[448px] flex-col items-center justify-center gap-4 sm:flex-row"
      >
        <Button variant="primary" href="/demo" class="w-full px-8 py-5 sm:w-auto"
          >Get a Demo</Button
        >
        <Button variant="secondary" href="/contact" class="w-full px-8 py-5 sm:w-auto"
          >Talk to Sales</Button
        >
      </div>
    </div>
  </div>
</section>

<style>
  section::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(136, 229, 76, 0.15) 0%,
      transparent 70%
    );
    border-radius: 50%;
    pointer-events: none;
  }

  section::after {
    content: '';
    position: absolute;
    bottom: -20%;
    left: -10%;
    width: 500px;
    height: 500px;
    background: radial-gradient(
      circle,
      rgba(17, 50, 36, 0.1) 0%,
      transparent 70%
    );
    border-radius: 50%;
    pointer-events: none;
  }
</style>
