---
import Button from './Button.astro';

const formatCurrency = (n: number) => '$' + n.toLocaleString();

const plans = [
  {
    employees: '50',
    perSeatMonthly: 1250,
    privaisyMonthly: 700,
    savings: 550,
  },
  {
    employees: '100',
    perSeatMonthly: 2500,
    privaisyMonthly: 700,
    savings: 1800,
  },
  {
    employees: '200',
    perSeatMonthly: 5000,
    privaisyMonthly: 700,
    savings: 4300,
  },
];
---
<section id="pricing"
  class="relative flex items-center overflow-hidden bg-pine/40"
  style="background: linear-gradient(0deg, rgba(17,50,36,0.4), rgba(17,50,36,0.4)), #2a4a3a;"
>
  <div class="relative z-10 mx-auto w-full max-w-page px-4 py-24">
    <div class="mx-auto flex max-w-[920px] flex-col items-center gap-4">
      <h2 class="text-h2 text-center text-white md:text-[40px]">
        One flat rate. Any team size.
      </h2>
      <p class="text-sub max-w-[600px] text-center text-white/60">
        Per-seat AI costs scale with every employee. Privaisy doesn't.
      </p>
    </div>

    <div
      class="mt-14 grid grid-cols-1 gap-6 md:grid-cols-3"
    >
      {plans.map((plan) => (
        <div
          class="flex flex-col gap-6 rounded-2xl border border-white/10 bg-white/5 p-8 backdrop-blur-sm"
        >
          <span class="text-h4 text-white">{plan.employees} employees</span>
          <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
              <span class="text-body text-white/40">Per-seat platforms</span>
              <span class="text-body-medium text-white/50 line-through"
                >{formatCurrency(plan.perSeatMonthly)}/mo</span
              >
            </div>
            <div class="flex items-center justify-between">
              <span class="text-body text-white/40">Privaisy</span>
              <span class="text-h5 text-lime"
                >{formatCurrency(plan.privaisyMonthly)}/mo</span
              >
            </div>
          </div>
          <div class="border-t border-white/10 pt-4">
            <span class="text-h4 text-lime"
              >Save {formatCurrency(plan.savings)}/mo</span
            >
          </div>
        </div>
      ))}
    </div>

    <p class="mt-8 text-center text-body text-white/30">
      + {formatCurrency(3500)} one-time contract initiation fee
    </p>

    <div
      class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row"
    >
      <Button variant="primary" href="/demo" class="w-full px-8 py-4 sm:w-auto"
        >Get a Demo</Button
      >
      <Button variant="white" href="/contact" class="w-full px-8 py-4 sm:w-auto"
        >Talk to Sales</Button
      >
    </div>
  </div>
</section>
