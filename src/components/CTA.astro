---
import Button from './Button.astro';
---
<section id="cta" class="bg-lime-50 px-4 py-28">
  <div class="mx-auto flex max-w-page flex-col items-center justify-center">
    <div class="flex max-w-[802px] flex-col items-center gap-10">
      <div class="flex flex-col items-center gap-6">
        <img src="/privaisy.svg" alt="Privaisy" class="h-6 w-auto" />
        <h2 class="text-h2 max-w-[566px] text-center text-pine">See how private AI feels</h2>
        <p class="text-sub max-w-[566px] text-center text-pine">Give your team the AI power they need — without the risk. Get started in under an hour.</p>
      </div>
      <Button variant="primary" href="/demo" class="w-full max-w-[448px] px-6 py-[17px]">Request a Demo</Button>
    </div>
  </div>
</section>
