---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect x="3" y="3" width="18" height="6" rx="2" stroke="currentColor" stroke-width="1.5"/>
  <rect x="3" y="15" width="18" height="6" rx="2" stroke="currentColor" stroke-width="1.5"/>
  <circle cx="7" cy="6" r="1" fill="currentColor"/>
  <circle cx="7" cy="18" r="1" fill="currentColor"/>
</svg>
