---
import { getCollection } from 'astro:content';
import ArrowRight from './icons/ArrowRight.astro';
import ImagePlaceholder from './ImagePlaceholder.astro';

const allPosts = await getCollection('blog');
const sorted = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = sorted.slice(0, 3);
---
<section id="blog" class="relative flex items-center overflow-hidden bg-pine/40 px-4 py-24"
  style="background: linear-gradient(0deg, rgba(17,50,36,0.4), rgba(17,50,36,0.4)), #2a4a3a;"
>
  <div class="mx-auto flex max-w-page flex-col gap-8">
    <div class="flex max-w-[648px] flex-col gap-6">
      <div class="flex items-center gap-2">
        <div class="h-2 w-2 rounded-full bg-lime"></div>
        <span class="text-label text-white">Blog</span>
      </div>
      <h2 class="text-h2 max-w-[566px] text-white">News and insights for privacy-minded teams</h2>
    </div>
    <div class="flex flex-col gap-6 md:flex-row">
      {latest.map((post) => (
        <article class="flex w-full flex-col overflow-hidden rounded-lg">
          <ImagePlaceholder variant="article" class="aspect-[4/3] w-full" />
          <div class="flex flex-col gap-6 bg-lime-50 p-6">
            <div class="flex flex-col gap-4">
              <h3 class="text-h5 text-pine">{post.data.title}</h3>
              <p class="font-body text-pine">{post.data.description}</p>
            </div>
            <a href={`/blog/${post.slug}`} class="inline-flex items-center gap-1 text-link text-white underline">
              Read article
              <ArrowRight class="h-5 w-5" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
